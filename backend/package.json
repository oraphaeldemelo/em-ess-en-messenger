{
    "name": "em-ess-en-messenger-backend",
    "version": "1.0.0",
    "description": "Backend do sistema de mensagens com Clean Architecture",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node tsconfig-paths/register dist/server.js",
        "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint src tests",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "fastify",
        "socket.io",
        "mongodb",
        "clean-architecture"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@fastify/cors": "^9.0.1",
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^12.2.0",
        "dotenv": "^16.3.1",
        "fastify": "^4.29.1",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.3.0",
        "socket.io": "^4.7.4",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/bcryptjs": "^2.4.6",
        "@types/better-sqlite3": "^7.6.13",
        "@types/jest": "^29.5.8",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.10.0",
        "@types/supertest": "^2.0.16",
        "@types/uuid": "^9.0.7",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^29.7.0",
        "prettier": "^3.9.7",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.2",
        "typescript-eslint": "^8.70.0"
    }
}
